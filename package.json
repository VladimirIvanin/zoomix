{
  "name": "zoomix",
  "version": "0.1.3",
  "description": "Lightweight product image zoom for storefronts",
  "type": "module",
  "module": "./dist/zoomix.js",
  "main": "./dist/zoomix.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/zoomix.js"
    },
    "./style.css": "./dist/zoomix.css",
    "./browser": "./dist/zoomix.min.js",
    "./browser-build/zoomix.min.js": "./browser-build/zoomix.min.js",
    "./browser-build/zoomix.css": "./browser-build/zoomix.css"
  },
  "files": [
    "dist",
    "browser-build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "dev": "vite --host 127.0.0.1",
    "test": "npm run build && npm run test:package && playwright test",
    "test:package": "node scripts/test-package.mjs",
    "prepack": "npm run build",
    "docs:build": "npm run build && node scripts/build-docs.mjs",
    "docs:preview": "vite preview --base /zoomix/ --outDir site --host 127.0.0.1",
    "check:release": "node scripts/check-release.mjs",
    "test:site": "npm run docs:build && node scripts/test-site.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@splidejs/splide": "4.1.4",
    "esbuild": "0.28.2",
    "swiper": "14.4.0",
    "tvist": "1.21.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VladimirIvanin/zoomix.git"
  },
  "bugs": {
    "url": "https://github.com/VladimirIvanin/zoomix/issues"
  },
  "homepage": "https://vladimirivanin.github.io/zoomix/",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "zoom",
    "image-zoom",
    "product",
    "insales",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "unpkg": "./browser-build/zoomix.min.js",
  "jsdelivr": "./browser-build/zoomix.min.js"
}
